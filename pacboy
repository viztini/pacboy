#!/usr/bin/env python3
import argparse
import subprocess
import sys
import re
import curses
import urllib.request
import json

# --- Global Force Flag ---
FORCE_MODE = False

# --- Theme Configuration ---

COLORS = {
    "pink": "\033[95m",
    "purple": "\033[94m",
    "light_blue": "\033[96m",
    "bold": "\033[1m",
    "underline": "\033[4m",
    "end": "\033[0m",
}

ASCII_ART = ""

# --- Custom Argument Parser ---

class PacboyArgumentParser(argparse.ArgumentParser):
    def error(self, message):
        if "invalid choice" in message:
            match = re.search(r"'(.*?)'", message)
            if match:
                invalid_command = match.group(1)
                self.exit(
                    2,
                    f"{colorize('pacboy:', 'pink', bold=True)} "
                    f"{invalid_command} is an invalid command :( "
                    f"please choose from install, remove, fremove, search, update, clean, clean-orphan\n"
                )
        super().error(message)

# --- Helper Functions ---

def confirm():
    if FORCE_MODE:
        return
    confirmation = input(f"{colorize('Proceed? (y/n)', 'purple')} ")
    if confirmation.lower() not in {'y', 'ye', 'yes'}:
        print(f"{colorize('Aborted by user. ;-;', 'pink')}")
        sys.exit(1)

def colorize(text, color, bold=False):
    style = COLORS["bold"] if bold else ""
    return f"{style}{COLORS[color]}{text}{COLORS['end']}"

def print_message(message):
    print(f"{colorize('pacboy:', 'pink', bold=True)} {message}")

def run_command(command, cwd=None):
    try:
        process = subprocess.run(command, shell=True, check=True, cwd=cwd)
        return process.returncode
    except subprocess.CalledProcessError as e:
        return e.returncode
    except KeyboardInterrupt:
        print_message("Operation cancelled by user. >.<")
        return 1

def levenshtein_distance(s1, s2):
    if len(s1) > len(s2):
        s1, s2 = s2, s1
    distances = range(len(s1) + 1)
    for i2, c2 in enumerate(s2):
        distances_ = [i2 + 1]
        for i1, c1 in enumerate(s1):
            if c1 == c2:
                distances_.append(distances[i1])
            else:
                distances_.append(
                    1 + min(distances[i1], distances[i1 + 1], distances_[-1])
                )
        distances = distances_
    return distances[-1]

# --- Pacman Commands ---

def install(packages):
    print_message(f"Analyzing packages... {colorize(', '.join(packages), 'light_blue')}")
    confirm()
    command = f"sudo pacman -S --noconfirm {' '.join(packages)}"
    run_command(command)

def remove(packages):
    print_message(f"Removing {colorize(', '.join(packages), 'light_blue')}...")
    confirm()
    command = f"sudo pacman -R --noconfirm {' '.join(packages)}"
    run_command(command)

def fremove(packages):
    print_message(
        colorize("FORCE REMOVAL ENABLED — SYSTEM MAY BREAK", "pink", bold=True)
    )
    confirm()
    command = f"sudo pacman -Rdd --noconfirm {' '.join(packages)}"
    run_command(command)

def update():
    print_message("Updating system...")
    confirm()
    run_command("sudo pacman -Syu")

def clean():
    print_message("Cleaning pacman cache...")
    confirm()
    run_command("sudo pacman --noconfirm -Sc")

def clean_orphan():
    print_message("Removing orphan packages...")
    try:
        orphans = subprocess.check_output(
            "pacman -Qtdq", shell=True, text=True
        ).splitlines()
        if not orphans:
            print_message("No orphan packages found.")
            return
        print_message("Orphans:")
        for o in orphans:
            print(f"  - {colorize(o, 'light_blue')}")
        confirm()
        run_command(f"sudo pacman -Rns --noconfirm {' '.join(orphans)}")
    except subprocess.CalledProcessError:
        print_message("No orphan packages found.")

# --- Main ---

def main():
    global FORCE_MODE

    parser = PacboyArgumentParser(
        description=f"{colorize('pacboy', 'pink', bold=True)}{colorize(' - Arch wrapper', 'purple')}",
        formatter_class=argparse.RawTextHelpFormatter
    )

    parser.add_argument(
        "--force",
        action="store_true",
        help="Force any command to run without confirmation or safety checks"
    )

    subparsers = parser.add_subparsers(dest="command")

    p_install = subparsers.add_parser("install")
    p_install.add_argument("packages", nargs="+")

    p_remove = subparsers.add_parser("remove")
    p_remove.add_argument("packages", nargs="+")

    p_fremove = subparsers.add_parser("fremove")
    p_fremove.add_argument("packages", nargs="+")

    p_search = subparsers.add_parser("search")
    p_search.add_argument("query")

    subparsers.add_parser("update")
    subparsers.add_parser("clean")
    subparsers.add_parser("clean-orphan")

    if len(sys.argv) == 1:
        parser.print_help()
        sys.exit(0)

    args = parser.parse_args()
    FORCE_MODE = args.force

    if args.command == "install":
        install(args.packages)
    elif args.command == "remove":
        remove(args.packages)
    elif args.command == "fremove":
        fremove(args.packages)
    elif args.command == "update":
        update()
    elif args.command == "clean":
        clean()
    elif args.command == "clean-orphan":
        clean_orphan()

if __name__ == "__main__":
    main()
